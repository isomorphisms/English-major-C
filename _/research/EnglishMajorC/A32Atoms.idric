  encoding_for_clearing_bits_selected_by_sign_extending_right_shift_without_changing_condition_flags

-- These are precisely the A32 operand forms admitted by the first parser.
-- Architectural A1 identifiers belong to external encoding metadata only.
-- No PC write, literal load, conditional execution, rotated immediate, or
-- arbitrary shifted operand is silently assimilated into these forms.
public export
choice a32_instruction one_of
  store_selected_thirty_two_bit_register_values_below_stack_pointer_and_update_stack_pointer_without_changing_condition_flags form_for_storing_selected_register_values_below_stack_pointer_with_stack_pointer_writeback a32_stack_member (List a32_stack_member)
  copy_thirty_two_bit_register_contents_without_changing_condition_flags form_for_copying_thirty_two_bit_register_contents_without_changing_condition_flags a32_data_register a32_data_register
  load_thirty_two_bits_from_base_plus_unsigned_immediate_without_base_writeback_or_condition_flag_changes form_for_loading_thirty_two_bits_using_base_plus_unsigned_immediate_without_base_writeback a32_data_register a32_non_pc_register Number
  store_thirty_two_bits_at_base_plus_unsigned_immediate_without_base_writeback_or_condition_flag_changes form_for_storing_thirty_two_bits_using_base_plus_unsigned_immediate_without_base_writeback a32_data_register a32_non_pc_register Number
  subtract_unrotated_eight_bit_immediate_without_changing_condition_flags form_for_subtracting_unrotated_eight_bit_immediate_without_changing_condition_flags a32_non_pc_register a32_non_pc_register Number
  clear_bits_selected_by_sign_extending_right_shift_without_changing_condition_flags form_for_clearing_bits_selected_by_sign_extending_right_shift_without_changing_condition_flags a32_data_register a32_data_register a32_data_register Number

-- This uses arbitrary precision Number; input range checks happen in the parser.
-- The result is an independent encoding check, not an ARM execution proof.
public export
power_of_two : Number → Number
power_of_two 0 = 1
power_of_two (S count) = 2 × power_of_two count

public export
selected_stack_register_encoding_mask : a32_stack_member → List a32_stack_member → Number
selected_stack_register_encoding_mask first rest =
  foldl (\sum, reg ⇒ sum + power_of_two (a32_stack_member_number reg))
        0 (first :: rest)

public export
expected_machine_word : a32_instruction → Number
expected_machine_word (store_selected_thirty_two_bit_register_values_below_stack_pointer_and_update_stack_pointer_without_changing_condition_flags _ first rest) =
  0xe92d0000 + selected_stack_register_encoding_mask first rest
expected_machine_word (copy_thirty_two_bit_register_contents_without_changing_condition_flags _ destination source) =
  0xe1a00000 + 4096 × a32_data_register_number destination +
    a32_data_register_number source
expected_machine_word (load_thirty_two_bits_from_base_plus_unsigned_immediate_without_base_writeback_or_condition_flag_changes _ destination base offset) =
  0xe5900000 + 65536 × a32_non_pc_register_number base +
    4096 × a32_data_register_number destination + offset
expected_machine_word (store_thirty_two_bits_at_base_plus_unsigned_immediate_without_base_writeback_or_condition_flag_changes _ source base offset) =
  0xe5800000 + 65536 × a32_non_pc_register_number base +
    4096 × a32_data_register_number source + offset
expected_machine_word (subtract_unrotated_eight_bit_immediate_without_changing_condition_flags _ destination source immediate) =
  0xe2400000 + 65536 × a32_non_pc_register_number source +
    4096 × a32_non_pc_register_number destination + immediate
expected_machine_word (clear_bits_selected_by_sign_extending_right_shift_without_changing_condition_flags _ destination source mask amount) =
  0xe1c00040 + 65536 × a32_data_register_number source +
    4096 × a32_data_register_number destination +
    128 × amount + a32_data_register_number mask

public export
describe_instruction : a32_instruction → Text
describe_instruction (store_selected_thirty_two_bit_register_values_below_stack_pointer_and_update_stack_pointer_without_changing_condition_flags _ first rest) =
  "store_selected_thirty_two_bit_register_values_below_stack_pointer_and_update_stack_pointer_without_changing_condition_flags|register_mask=" ++ show (selected_stack_register_encoding_mask first rest)
describe_instruction (copy_thirty_two_bit_register_contents_without_changing_condition_flags _ destination source) =
  "copy_thirty_two_bit_register_contents_without_changing_condition_flags|r" ++ show (a32_data_register_number destination) ++
    "|r" ++ show (a32_data_register_number source)
describe_instruction (load_thirty_two_bits_from_base_plus_unsigned_immediate_without_base_writeback_or_condition_flag_changes _ destination base offset) =
  "load_thirty_two_bits_from_base_plus_unsigned_immediate_without_base_writeback_or_condition_flag_changes|r" ++ show (a32_data_register_number destination) ++
    "|r" ++ show (a32_non_pc_register_number base) ++ "|" ++ show offset
describe_instruction (store_thirty_two_bits_at_base_plus_unsigned_immediate_without_base_writeback_or_condition_flag_changes _ source base offset) =
  "store_thirty_two_bits_at_base_plus_unsigned_immediate_without_base_writeback_or_condition_flag_changes|r" ++ show (a32_data_register_number source) ++
    "|r" ++ show (a32_non_pc_register_number base) ++ "|" ++ show offset
describe_instruction (subtract_unrotated_eight_bit_immediate_without_changing_condition_flags _ destination source immediate) =
  "subtract_unrotated_eight_bit_immediate_without_changing_condition_flags|r" ++ show (a32_non_pc_register_number destination) ++
    "|r" ++ show (a32_non_pc_register_number source) ++ "|" ++ show immediate
describe_instruction (clear_bits_selected_by_sign_extending_right_shift_without_changing_condition_flags _ destination source mask amount) =
  "clear_bits_selected_by_sign_extending_right_shift_without_changing_condition_flags|r" ++ show (a32_data_register_number destination) ++
    "|r" ++ show (a32_data_register_number source) ++
    "|r" ++ show (a32_data_register_number mask) ++ "|sign_extending_right_shift|" ++ show amount

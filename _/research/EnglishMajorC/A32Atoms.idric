register_from_text "r13" = Just (register_r13 physical_r13)
register_from_text "r14" = Just (register_r14 physical_r14)
register_from_text "r15" = Just (register_r15 physical_r15)
register_from_text "sb" = Just (register_r9 physical_r9)
register_from_text "sl" = Just (register_r10 physical_r10)
register_from_text "fp" = Just (register_r11 physical_r11)
register_from_text "ip" = Just (register_r12 physical_r12)
register_from_text "sp" = Just (register_r13 physical_r13)
register_from_text "lr" = Just (register_r14 physical_r14)
register_from_text "pc" = Just (register_r15 physical_r15)
register_from_text _ = Nothing


module EnglishMajorC.A32Atoms

import Data.Text

-- Register identities are singleton TYPES. No Number or Text is substituted
-- for a physical register after parsing. Abbreviations (sl/ip/sp/lr/pc) point
-- to existing physical types rather than introducing extra registers.

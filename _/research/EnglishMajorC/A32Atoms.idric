public export
register_from_text : Text → Maybe a32_register
register_from_text "r0" = Just (register_r0 physical_r0)
register_from_text "r1" = Just (register_r1 physical_r1)
register_from_text "r2" = Just (register_r2 physical_r2)
register_from_text "r3" = Just (register_r3 physical_r3)
register_from_text "r4" = Just (register_r4 physical_r4)
